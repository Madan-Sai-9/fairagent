# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Jupyter
.ipynb_checkpoints/

# Environments
.env
.venv
env/
venv/

# Model weights / large binaries (these live in Kaggle Datasets, not GitHub)
*.gguf
*.bin
*.safetensors
ollama_models/

# Results (canonical copy lives in the Kaggle results/ Dataset, not GitHub)
*.csv
!results/README.md
# ...except small aggregated analysis outputs (a handful of summary rows,
# not raw trial data) — these belong in GitHub alongside the figures/notes
# that cite them.
!analysis/*.csv

# Logs
*.log

# OS junk
.DS_Store
Thumbs.db

# Kaggle/Colab local state
.kaggle/
